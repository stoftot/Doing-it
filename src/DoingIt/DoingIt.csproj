<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>DoingIt</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationTitle>Doing it</ApplicationTitle>
    <ApplicationId>com.doingit.app</ApplicationId>
    <ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
    <ApplicationVersion>2</ApplicationVersion>
    <SupportedOSPlatformVersion>23.0</SupportedOSPlatformVersion>
    <AndroidPackageFormats>apk</AndroidPackageFormats>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <DiagnosticBuildStamp>$([System.DateTime]::UtcNow.ToString("yyyyMMddTHHmmssZ"))</DiagnosticBuildStamp>
    <DefineConstants Condition="'$(DiagnosticTestHooks)' == 'true'">$(DefineConstants);DIAGNOSTIC_TEST_HOOKS</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#1D4C5E" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#1D4C5E" BaseSize="128,128" />
    <MauiImage Include="Resources\Images\*.svg" />
    <MauiFont Include="Resources\Fonts\*" />
  </ItemGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>DiagnosticBuild</_Parameter1>
      <_Parameter2>$(DiagnosticBuildStamp)</_Parameter2>
    </AssemblyAttribute>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <ProjectReference Include="..\DoingIt.Core\DoingIt.Core.csproj" />
  </ItemGroup>
</Project>
