<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal" android:gravity="center" android:padding="10dp"
    android:background="@drawable/widget_background">
    <TextView android:id="@+id/widget_number" android:layout_width="0dp" android:layout_height="match_parent"
        android:layout_weight="1" android:gravity="center" android:text="—"
        android:textColor="@color/widget_teal" android:textSize="34sp" android:textStyle="bold"
        android:fontFamily="sans-serif-medium" android:maxLines="1" android:includeFontPadding="false"
        android:autoSizeTextType="uniform" android:autoSizeMinTextSize="16sp" android:autoSizeMaxTextSize="34sp" android:autoSizeStepGranularity="1sp" />
    <TextView android:id="@+id/widget_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginStart="6dp" android:maxWidth="70dp" android:gravity="center_vertical"
        android:text="@string/widget_loading" android:textColor="@color/widget_teal" android:textSize="13sp" android:maxLines="2" />
</LinearLayout>
